# ─── SMS / OTP Providers ───
# At least ONE provider must be configured for OTP delivery.
# If both are set, MSG91 is tried first, then Fast2SMS as fallback.

# MSG91 (Primary — DLT-approved, best for India production)
# Get your auth key from: https://control.msg91.com
# Create an OTP template and paste the template_id below
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Fast2SMS (Fallback — quick setup, good for development)
# Get your API key from: https://www.fast2sms.com
FAST2SMS_API_KEY=
