generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  name                String
  phone               String?
  college             String?
  city                String?
  state               String          @default("")
  district            String          @default("")
  avatar              String?
  isVerified          Boolean         @default(false)
  isAdmin             Boolean         @default(false)
  adminRole           String?         // "super_admin" | "moderator" | "support_admin"
  passwordHash        String?         // bcrypt hashed password for admin accounts
  mustChangePassword  Boolean         @default(false) // force password change on first login
  twoFactorEnabled    Boolean         @default(false) // 2FA enabled (auto-on for super_admin)
  isSuperAdmin        Boolean         @default(false) // immutable flag: true only for the primary Super Admin
  isBanned            Boolean         @default(false)
  rating              Float           @default(0)
  totalSales          Int             @default(0)
  whatsapp            String?
  // Upload credits
  freeUploadUsed      Int             @default(0)
  paidUploadCredits   Int             @default(0)
  totalBooksUploaded  Int             @default(0)
  // Premium Plan
  planType            String          @default("normal") // "normal" | "premium"
  premiumActive       Boolean         @default(false)
  premiumBooksUsed    Int             @default(0)
  premiumBookLimit    Int             @default(29)
  premiumExpiryDate   DateTime?
  premiumPurchaseDate DateTime?
  // ─── Security Question (Password Reset Recovery) ───
  securityQuestionIdx Int?            // index (0-6) into the SECURITY_QUESTIONS list, null if not set
  securityAnswerHash  String?         // bcrypt hash of normalized answer (never store plaintext)
  securityAttempts    Int             @default(0) // failed verification attempts (for brute-force protection)
  securityLockedUntil DateTime?      // lockout expiry timestamp; if set, answer verification is blocked
  securityUpdatedAt   DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  listings            Listing[]
  wishlistItems       Wishlist[]
  reports             Report[]        @relation("Reporter")
  adminSessions       AdminSession[]
  auditLogs           AuditLog[]      @relation("AuditActor")
  payments            Payment[]
  sessions            UserSession[]
}

model Listing {
  id             String     @id @default(cuid())
  title          String
  description    String
  originalPrice  Float
  sellingPrice   Float
  category       String
  subcategory    String?
  listingType    String     @default("sell")
  course         String?
  semester       String?
  standard       String?
  board          String?
  college        String?
  state          String     @default("")
  district       String     @default("")
  city           String     @default("")
  condition      String
  images         String     @default("[]")
  whatsappNumber String
  isFeatured     Boolean    @default(false)
  isUrgent       Boolean    @default(false)
  isVerified     Boolean    @default(false)
  isSold         Boolean    @default(false)
  isDigital      Boolean    @default(false)
  fileUrl        String?
  uploadType     String     @default("normal") // "normal" | "premium"
  views          Int        @default(0)
  saves          Int        @default(0)
  sellerId       String
  seller         User       @relation(fields: [sellerId], references: [id])
  wishlistBy     Wishlist[]
  reports        Report[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([uploadType])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Report {
  id         String   @id @default(cuid())
  listingId  String
  reporterId String
  reason     String
  isResolved Boolean  @default(false)
  listing    Listing  @relation(fields: [listingId], references: [id])
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id])
  createdAt  DateTime @default(now())
}

model AdminSession {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String   // "ban_user" | "delete_listing" | "verify_seller" | etc.
  targetType String   // "user" | "listing" | "report"
  targetId   String
  details    String?  // JSON string with extra info
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  amount          Float    @default(10)
  paymentMethod   String   @default("upi_qr") // "upi_qr" | "razorpay"
  paymentType     String   @default("upload_fee") // "upload_fee" | "premium_plan"
  utrNumber       String?  // UTR/reference number from user
  screenshotUrl   String?  // uploaded screenshot URL
  upiId           String?  // UPI ID used for payment
  status          String   @default("pending") // "pending" | "verified" | "rejected" | "expired"
  uploadCredit    Int      @default(1) // credits granted after verification
  expiresAt       DateTime // 5 minute expiry for pending payments
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([utrNumber])
  @@index([expiresAt])
  @@index([paymentType])
}

model SiteConfig {
  id        String   @id @default("default")
  upiId     String   @default("sagathiyapradip1137-3@oksbi")
  upiName   String   @default("EduCampusHub")
  updatedAt DateTime @updatedAt
}

model RateLimitEntry {
  id        String   @id @default(cuid())
  key       String   @unique // IP or userId + route
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([key])
  @@index([resetAt])
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetOTP {
  id         String   @id @default(cuid())
  email      String                                    // user/admin email
  phone      String?                                   // phone number (optional for email OTP)
  otpCode    String                                    // 6-digit OTP
  purpose    String   @default("forgot_password") // "forgot_password" | "admin_login" | "admin_forgot_password"
  isVerified Boolean  @default(false)                  // whether OTP was successfully verified
  expiresAt  DateTime                                  // 5-minute expiry
  createdAt  DateTime  @default(now())
  usedAt     DateTime?                                 // when OTP was used

  @@index([email])
  @@index([otpCode])
  @@index([expiresAt])
  @@index([purpose])
  @@index([email, purpose])
}
